
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Aturan umum untuk mengizinkan pengguna menulis ke folder mereka sendiri.
    // Ini berlaku untuk /notas/{userId}, /hr_attendance/{userId}, /gamas-photos/{userId}, dll.
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Aturan default, mengizinkan semua orang untuk membaca file.
    // Ini penting agar gambar dapat ditampilkan di aplikasi.
    match /{allPaths=**} {
      allow read;
    }
  }
}
