
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isApproved() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.registrationStatus == 'approved';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin';
    }
    
    function isKorlap() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'korlap';
    }

    function isCreatingOwn(docName) {
      return request.resource.data[docName] == request.auth.uid;
    }

    function isUpdatingOwn(docName) {
      return resource.data[docName] == request.auth.uid;
    }
    
    function hasAllProAccess() {
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isApproved() && (userProfile.role == 'admin' || userProfile.appAccess == 'allpro' || userProfile.appAccess == 'all');
    }

    // -------------------------------------------------------------------------
    // Rules
    // -------------------------------------------------------------------------
    
    match /users/{userId} {
      allow create: if request.auth.uid == userId && request.resource.data.email is string && request.resource.data.role == 'teknisi' && request.resource.data.registrationStatus == 'pending';
      // READ: A user can get their own profile. Admins/Korlaps can get any profile.
      allow get: if isOwner(userId) || isAdmin() || isKorlap();
      allow list: if isApproved();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /notas/{notaId} {
      allow get, list: if isApproved() || isAdmin();
      allow create: if isApproved() && isCreatingOwn('userId');
      allow update: if (isApproved() && isUpdatingOwn('userId')) || isAdmin();
      allow delete: if (isApproved() && isUpdatingOwn('userId')) || isAdmin();
    }

    match /project-ids/{projectId} {
      allow get, list: if isApproved() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /network-assets/{assetId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow create, update, delete: if isAdmin();
    }

    match /pelanggan/{pelangganId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow create: if isKorlap() || (hasAllProAccess() && isCreatingOwn('userId'));
      allow update: if isKorlap() || (hasAllProAccess() && isUpdatingOwn('userId')) || isAdmin();
      allow delete: if isAdmin() || isKorlap();
    }

    match /riwayat-gangguan/{riwayatId} {
      // Admins/Korlaps can write via file import. Server can write via webhook.
      allow write: if isAdmin() || isKorlap(); 
      allow read: if hasAllProAccess() || isKorlap();
    }

    match /map-links/{mapLinkId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow create, update, delete: if isAdmin();
    }

    match /mancore-links/{mancoreLinkId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow create, update, delete: if isAdmin();
    }

    match /network-stats/{statId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow write: if isAdmin();
    }

    match /holidays/{holidayId} {
      allow get, list: if isApproved();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow get: if isOwner(resource.data.userId) || isAdmin() || isKorlap();
      allow list: if isApproved();
      allow create: if (isAdmin() || isKorlap()) || (isCreatingOwn('userId') && (request.resource.data.shiftType == 'ijin' || request.resource.data.shiftType == 'cuti'));
      allow update: if isOwner(resource.data.userId) || isAdmin() || isKorlap();
      allow delete: if isAdmin() || isKorlap();
    }

    match /attendances/{attendanceId} {
      allow get: if isOwner(resource.data.userId) || isAdmin() || isKorlap();
      allow list: if isApproved();
      allow create: if isCreatingOwn('userId');
      allow update, delete: if isAdmin();
    }

    match /tool-checklists/{checklistId} {
      allow get: if isOwner(checklistId) || isAdmin() || isKorlap();
      allow list: if isApproved();
      allow create: if isApproved() && isCreatingOwn('userId') && checklistId == request.auth.uid;
      allow update, delete: if (isApproved() && isUpdatingOwn('userId')) || isAdmin() || isKorlap();
    }
    
    match /messages/{messageId} {
      allow read: if isApproved();
      allow create: if isApproved() && isCreatingOwn('userId');
    }

    match /chats/{chatId} {
      // Allow read (get/list) if the user is a participant.
      // This rule works with the client-side query: `where('participants', 'array-contains', request.auth.uid)`
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Allow write (create/update) if the user is a participant (based on the immutable doc ID) and the new data is valid.
      allow write: if isSignedIn() &&
                      request.auth.uid in chatId.split('_') &&
                      request.resource.data.participants.hasAll(chatId.split('_')) &&
                      request.resource.data.participants.size() == 2;
      
      match /messages/{messageId} {
        // To read/write messages, the user must be a participant in the parent chat room document.
        // We must check if the parent document exists before trying to access its data.
        allow read, write: if isSignedIn() &&
                              exists(/databases/$(database)/documents/chats/$(chatId)) &&
                              request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
