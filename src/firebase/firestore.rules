
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isApproved() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.registrationStatus == 'approved';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin';
    }
    
    function isKorlap() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'korlap';
    }

    function isCreatingOwn(docName) {
      return request.resource.data[docName] == request.auth.uid;
    }

    function isUpdatingOwn(docName) {
      return resource.data[docName] == request.auth.uid;
    }
    
    function hasAllProAccess() {
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isApproved() && (userProfile.role == 'admin' || userProfile.role == 'korlap' || userProfile.appAccess == 'allpro' || userProfile.appAccess == 'all');
    }

    function isBorrowingDevice() {
        return request.resource.data.status == 'borrowed'
            && resource.data.status == 'available'
            && request.resource.data.borrowedByUserId == request.auth.uid;
    }

    function isReturningDevice() {
        return request.resource.data.status == 'available'
            && resource.data.status == 'borrowed'
            && resource.data.borrowedByUserId == request.auth.uid;
    }

    function isChangingLoanStatus() {
        return isApproved() && (isBorrowingDevice() || isReturningDevice());
    }

    // -------------------------------------------------------------------------
    // Rules
    // -------------------------------------------------------------------------
    
    match /users/{userId} {
      function userCanUpdateOwnProfile() {
        let incoming = request.resource.data;
        let existing = resource.data;
        // Fields a user CANNOT change for themselves. They can only be changed by an admin.
        return incoming.role == existing.role &&
               incoming.registrationStatus == existing.registrationStatus &&
               incoming.appAccess == existing.appAccess &&
               incoming.nik == existing.nik;
      }
      
      allow create: if request.auth.uid == userId && request.resource.data.email is string && request.resource.data.role == 'teknisi' && request.resource.data.registrationStatus == 'pending';
      // READ: Any signed-in user can get any user's profile. This is required for various features like chat and helpers like isApproved/isAdmin.
      allow get: if isSignedIn();
      allow list: if isApproved();
      allow update: if isAdmin() || (isOwner(userId) && userCanUpdateOwnProfile());
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /notas/{notaId} {
      allow get, list: if isApproved() || isAdmin();
      allow create: if isApproved() && isCreatingOwn('userId');
      allow update: if (isApproved() && isUpdatingOwn('userId')) || isAdmin();
      allow delete: if (isApproved() && isUpdatingOwn('userId')) || isAdmin();
    }
    
    match /gamas-reports/{reportId} {
      allow read: if isApproved() || isAdmin() || isKorlap();
      allow create: if isApproved() && isCreatingOwn('userId');
      allow update, delete: if (isApproved() && isUpdatingOwn('userId')) || isAdmin() || isKorlap();
    }

    match /project-ids/{projectId} {
      allow get, list: if isApproved() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /network-assets/{assetId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow create, update, delete: if isAdmin();
    }

    match /pelanggan/{pelangganId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow create: if isApproved() && isCreatingOwn('userId');
      allow update: if isKorlap() || (hasAllProAccess() && isUpdatingOwn('userId')) || isAdmin();
      allow delete: if isAdmin() || isKorlap();
    }

    match /riwayat-gangguan/{riwayatId} {
      allow create: if isApproved() && isCreatingOwn('userId');
      allow read: if isApproved(); // Allow any approved user to read
      allow update, delete: if isAdmin() || isKorlap();
    }

    match /map-links/{mapLinkId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow create, update, delete: if isAdmin();
    }

    match /mancore-links/{mancoreLinkId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow create, update, delete: if isAdmin();
    }

    match /network-stats/{statId} {
      allow get, list: if hasAllProAccess() || isKorlap();
      allow write: if isAdmin();
    }
    
    match /orbit-inventory/{inventoryId} {
      allow get, list: if isApproved();
      allow create, delete: if isAdmin();
      // Allow admin to update anything, and approved users to borrow/return.
      allow update: if isAdmin() || isChangingLoanStatus();
    }

    match /holidays/{holidayId} {
      allow get, list: if isApproved();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow get: if isOwner(resource.data.userId) || isAdmin() || isKorlap();
      allow list: if isApproved();
      allow create: if (isAdmin() || isKorlap()) || (isCreatingOwn('userId') && (request.resource.data.shiftType == 'ijin' || request.resource.data.shiftType == 'cuti' || request.resource.data.shiftType == 'tukar-jaga'));
      allow update: if isOwner(resource.data.userId) || isAdmin() || isKorlap();
      allow delete: if isAdmin() || isKorlap();
    }

    match /attendances/{attendanceId} {
      allow get: if isOwner(resource.data.userId) || isAdmin() || isKorlap();
      allow list: if isApproved();
      allow create: if isCreatingOwn('userId');
      allow update, delete: if isAdmin();
    }

    match /tool-checklists/{checklistId} {
      allow get: if isOwner(checklistId) || isAdmin() || isKorlap();
      allow list: if isApproved();
      allow create: if isApproved() && isCreatingOwn('userId') && checklistId == request.auth.uid;
      allow update, delete: if (isApproved() && isUpdatingOwn('userId')) || isAdmin() || isKorlap();
    }
    
    match /messages/{messageId} {
      allow read: if isApproved();
      allow create: if isApproved() && isCreatingOwn('userId');
    }

    match /chats/{chatId} {
      // A user can read a chat document if they are a participant.
      // This rule works for both `get` and `list` (queries).
      // For 'list', the client MUST include a `where('participants', 'array-contains', request.auth.uid)` clause.
      allow read: if isSignedIn() && 'participants' in resource.data && request.auth.uid in resource.data.participants;

      // Allow write (create/update) if the user is a participant (based on the immutable doc ID) and the new data is valid.
      allow write: if isSignedIn() &&
                      request.auth.uid in chatId.split('_') &&
                      request.resource.data.participants.hasAll(chatId.split('_')) &&
                      request.resource.data.participants.size() == 2;
      
      match /messages/{messageId} {
        // `get` (read one doc) and `write` can use get() to check parent document's participants list.
        allow get, write: if isSignedIn() &&
                             exists(/databases/$(database)/documents/chats/$(chatId)) &&
                             request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
                             
        // `list` (queries) cannot use `get()` or `exists()`. 
        // We rely on the `chatId` itself, which is a composite of the two participant UIDs.
        allow list: if isSignedIn() && request.auth.uid in chatId.split('_');
      }
    }
    
    match /performance/{performanceId} {
       // Allow admin/korlap to read anything. Regular users can list their own records.
       allow get: if isAdmin() || isKorlap() || (isSignedIn() && resource.data.userId == request.auth.uid);
       allow list: if isApproved();
       allow write: if isAdmin() || isKorlap();
    }
  }
}
