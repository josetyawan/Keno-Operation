
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isApproved() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.registrationStatus == 'approved';
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin';
    }

    function isKorlap() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'korlap';
    }

    function hasAllProAccess() {
      if (!isSignedIn()) {
        return false;
      }
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userProfile.registrationStatus == 'approved' && 
             (userProfile.role == 'admin' || userProfile.role == 'korlap' || userProfile.appAccess == 'allpro' || userProfile.appAccess == 'all');
    }

    // Public read access is fine for image URLs
    match /{allPaths=**} {
      allow read;
    }

    // --- WRITE RULES ---
    
    match /notas/{userId}/{allPaths=**} {
      allow write: if isApproved() && isOwner(userId);
    }

    match /pelanggan_photos/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /hr_attendance/{userId}/{allPaths=**} {
      allow write: if isApproved() && isOwner(userId);
    }
    
    match /gamas-photos/{userId}/{allPaths=**} {
       allow write: if isApproved() && isOwner(userId);
    }

    match /alker-photos/{userId}/{allPaths=**} {
       allow write: if isApproved() && isOwner(userId);
    }
  }
}
