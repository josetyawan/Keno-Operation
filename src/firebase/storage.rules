rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Public read access is fine for image URLs as they are unguessable.
    match /{allPaths=**} {
      allow read;
    }

    // --- WRITE RULES ---
    // A user can only write to a folder that matches their own user ID, provided they are authenticated.
    match /notas/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /pelanggan_photos/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /hr_attendance/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /gamas-photos/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /alker-photos/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
