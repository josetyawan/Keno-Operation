
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Public read access is fine for image URLs
    match /{allPaths=**} {
      allow read;
    }

    // --- WRITE RULES ---
    
    // User can only write to their own 'notas' folder
    match /notas/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User can only write to their own 'pelanggan_photos' folder
    match /pelanggan_photos/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User can only write to their own 'hr_attendance' folder
    match /hr_attendance/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User can only write to their own 'gamas-photos' folder
    match /gamas-photos/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User can only write to their own 'alker-photos' folder
    match /alker-photos/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
