
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isApproved() {
      // isApproved requires a cross-service call to Firestore.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.registrationStatus == 'approved';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read;
    }

    match /notas/{userId}/{allPaths=**} {
      allow write: if isApproved() && isOwner(userId);
    }

    match /pelanggan_photos/{userId}/{allPaths=**} {
      allow write: if isApproved() && isOwner(userId);
    }

    match /hr_attendance/{userId}/{allPaths=**} {
      allow write: if isApproved() && isOwner(userId);
    }
    
    // Simplified rule for diagnostics
    match /gamas-photos/{userId}/{allPaths=**} {
       allow write: if request.auth != null;
    }

    match /alker-photos/{userId}/{allPaths=**} {
       allow write: if isApproved() && isOwner(userId);
    }
  }
}
