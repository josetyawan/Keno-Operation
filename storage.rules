rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for the 'notas' directory
    match /notas/{userId}/{allPaths=**} {
      // Allow anyone to read files if they have the URL.
      // This is necessary for displaying images in the app for all users.
      allow read: if true;

      // Allow write operations (create, update, delete) only if the
      // requesting user is authenticated and their UID matches the 'userId'
      // in the file path. This ensures users can only write to their own folder.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
