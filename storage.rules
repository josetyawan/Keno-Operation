
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Default public read for all files to allow image display in the app
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Secure write rules for specific folders.
    // The check `request.auth.uid == userId` implicitly ensures request.auth is not null.
    // This is a more concise and standard way to write this rule.
    
    match /profile-pictures/{userId}/{fileName} {
      allow write: if request.auth.uid == userId;
    }
    
    match /notas/{userId}/{fileName} {
      allow write: if request.auth.uid == userId;
    }
    
    match /pelanggan/{userId}/{fileName} {
      allow write: if request.auth.uid == userId;
    }

    match /hr_attendance/{userId}/{fileName} {
      allow write: if request.auth.uid == userId;
    }
    
    match /alker-photos/{allPaths=**} {
      // Workaround: Allow any authenticated user to write to the alker-photos path
      // to resolve a persistent and unusual permissions issue. The user's UID is
      // still part of the file path, ensuring traceability.
      allow write: if request.auth != null;
    }
  }
}
