rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Aturan sementara untuk diagnostik:
    // Izinkan semua pengguna yang terautentikasi untuk membaca dan menulis.
    // Ini akan diganti dengan aturan yang lebih aman setelah masalah CORS teratasi.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
