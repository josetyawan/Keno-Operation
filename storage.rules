rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The `notas` folder contains all user uploads.
    // Each user has their own folder inside, named after their UID.
    match /notas/{userId}/{allPaths=**} {

      // Allow anyone to read files. This is required so that images
      // can be displayed within the application to all users.
      allow read: if true;

      // Allow a user to write (create, update, delete) ONLY to their
      // own folder. This is the core security principle.
      // It works by checking if the UID of the user making the request
      // (`request.auth.uid`) is the same as the folder name (`userId`).
      allow write: if request.auth.uid == userId;
    }
  }
}
