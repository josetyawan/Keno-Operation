
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Public read access for all files is generally safe for app assets like images.
    match /{allPaths=**} {
      allow read;
    }

    // --- WRITE RULES ---
    // General principle: A user can only write to their own folder, and must be logged in.

    match /notas/{userId}/{allPaths=**} {
      allow write: if isOwner(userId);
    }

    match /pelanggan_photos/{userId}/{allPaths=**} {
      allow write: if isOwner(userId);
    }

    match /hr_attendance/{userId}/{allPaths=**} {
      allow write: if isOwner(userId);
    }
    
    match /gamas-photos/{userId}/{allPaths=**} {
       allow write: if isOwner(userId);
    }

    match /alker-photos/{userId}/{allPaths=**} {
       allow write: if isOwner(userId);
    }
  }
}
