rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // This is a temporary, insecure rule for diagnostic purposes.
    // It allows any authenticated user to write to any file under the /notas/ path.
    // This helps isolate whether the issue is with authentication itself or with the
    // ownership check (request.auth.uid == userId).
    match /notas/{allPaths=**} {
      // Public read access is still safe and necessary.
      allow read: if true;

      // Allow write if the user is signed in, regardless of the path.
      allow write: if request.auth != null;
    }
  }
}
