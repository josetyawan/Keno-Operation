
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Helper function to check if a user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Default public read for all files to allow image display in the app
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Secure write rules for specific folders
    match /profile-pictures/{userId}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /notas/{userId}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /pelanggan/{userId}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /hr_attendance/{userId}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /alker-photos/{userId}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}

