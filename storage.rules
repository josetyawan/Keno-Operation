rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access for all files so images can be displayed.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Secure write access for notas. Only the authenticated owner can write.
    match /notas/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Secure write access for profile pictures. Only the owner can upload their own picture.
    match /profile-pictures/{userId} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
