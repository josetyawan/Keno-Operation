rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match files within the 'notas' directory, structured by user ID.
    match /notas/{userId}/{allPaths=**} {
      
      // Allow anyone to read files. This is required for displaying images
      // in the app via their public URL.
      allow read: if true;
      
      // Only allow a user to write (create, update, delete) to their own folder.
      // The user's auth UID must match the {userId} in the file path.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
