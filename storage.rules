
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match the path for user-specific nota files
    match /notas/{userId}/{allPaths=**} {
      // Allow anyone to read the files. This is necessary for displaying images in the app.
      allow read: if true;

      // Allow write (create, update, delete) only if the user is authenticated 
      // AND their UID matches the {userId} in the path.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
