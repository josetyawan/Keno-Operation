rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // PUBLIC READ: Allow public read access for all files so images can be displayed.
    match /{allPaths=**} {
      allow read: if true;
    }

    // NOTAS WRITE: Secure write access for notas. Only the owner can write.
    // This rule is for the 'notas' folder.
    match /notas/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
