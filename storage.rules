rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // This rule applies to files stored in the 'notas/' directory.
    // The path is structured as /notas/{userId}/{allPaths=**}, where {userId} is
    // the UID of the user who is uploading the file.
    match /notas/{userId}/{allPaths=**} {
      
      // PUBLIC READ ACCESS
      // Allow anyone to read files if they have the public URL. This is crucial
      // for displaying evidence photos to all users in the application,
      // especially for admins or other users viewing the nota details.
      allow read: if true;

      // RESTRICTED WRITE ACCESS
      // Allow a user to write (upload, update, delete) files only if:
      // 1. The user is authenticated (request.auth != null).
      // 2. The user's UID matches the {userId} directory in the path.
      // This ensures that users can only write to their own designated folder.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
