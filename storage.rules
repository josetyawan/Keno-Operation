
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Generic rule for user-owned folders.
    // This covers 'notas', 'profile-pictures', 'pelanggan', 'hr_attendance', 'alker-photos'.
    match /{folder}/{userId}/{fileName}
      where folder in ['notas', 'profile-pictures', 'pelanggan', 'hr_attendance', 'alker-photos'] {
      allow write: if request.auth.uid == userId;
    }

    // Default public read for all files to allow image display in the app.
    match /{allPaths=**} {
      allow read: if true;
    }
  }
}
