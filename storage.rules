rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // PUBLIC READ is okay for app functionality.
    // INSECURE/DIAGNOSTIC - Allow any authenticated user to write anywhere.
    // This is a temporary measure to debug a persistent permissions issue.
    match /{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}
