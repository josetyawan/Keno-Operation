rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // PERINGATAN: Aturan ini tidak aman dan hanya untuk tujuan diagnosis.
      // Aturan ini mengizinkan siapa saja di internet untuk membaca dan menulis
      // ke Storage Anda.
      allow read, write: if true;
    }
  }
}
