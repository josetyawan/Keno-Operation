
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // --- WRITE RULES ---
    // These are specific rules. A user can only write to a folder that matches their UID.

    // Allow writes for attendance photos
    match /hr_attendance/{userId}/{filename} {
      allow write: if request.auth.uid == userId;
    }
    
    // Allow writes for nota evidence
    match /notas/{userId}/{filename} {
      allow write: if request.auth.uid == userId;
    }

    // Allow writes for Gamas report photos
    match /gamas-photos/{userId}/{filename} {
       allow write: if request.auth.uid == userId;
    }

    // Allow writes for Alker checklist photos
    match /alker-photos/{userId}/{filename} {
       allow write: if request.auth.uid == userId;
    }

    // --- READ RULE ---
    // A single, global rule to allow public read access for all files.
    // This is necessary for the app to display the uploaded images.
    match /{allPaths=**} {
      allow read;
    }
  }
}
