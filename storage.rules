
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // WARNING: TEMPORARY DEBUGGING RULE - NOT SECURE
    // This rule allows anyone to read or write any file.
    // It is only for testing to confirm that the security rules
    // are the source of the "unauthorized" error.
    // This MUST be replaced with secure rules afterward.
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
