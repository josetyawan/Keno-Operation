rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /notas/{userId}/{allPaths=**} {
      // Izinkan siapa saja untuk membaca (melihat) gambar jika mereka memiliki URL.
      // Ini penting agar gambar dapat ditampilkan di dasbor untuk semua pengguna.
      allow read: if true;

      // Izinkan penulisan (unggah, perbarui, hapus) HANYA jika ID pengguna yang
      // sedang login (request.auth.uid) sama dengan ID pengguna di path file (userId).
      // Ini memastikan pengguna hanya bisa menulis ke folder mereka sendiri.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
