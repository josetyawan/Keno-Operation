rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Matches all files in the 'notas' folder
    match /notas/{userId}/{allPaths=**} {

      // Anyone can read any file. This is necessary for displaying images
      // to all users in the application.
      allow read: if true;

      // Only the authenticated user whose UID matches the {userId} in the path
      // can write (upload, update, delete) to their own folder.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
