
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isApproved() {
      return isSignedIn() &&
             exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.registrationStatus == 'approved';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin';
    }

    function isKorlap() {
      return isSignedIn() && 
             exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.role.lower() == 'korlap';
    }
    
     function hasAllProAccess() {
      // This single read is more efficient than calling isApproved() then reading role/appAccess separately.
      let userProfile = get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() &&
            userProfile.registrationStatus == 'approved' &&
            (userProfile.role == 'admin' || userProfile.role == 'korlap' || userProfile.appAccess == 'allpro' || userProfile.appAccess == 'all');
    }

    // Public read access is fine for image URLs
    match /{allPaths=**} {
      allow read;
    }

    // --- WRITE RULES ---
    
    match /notas/{userId}/{allPaths=**} {
      allow write: if isApproved() && isOwner(userId);
    }

    match /pelanggan_photos/{userId}/{allPaths=**} {
      allow write: if isOwner(userId);
    }
    
    match /gangguan_evidence/{userId}/{allPaths=**} {
      allow write: if isApproved() && isOwner(userId);
    }

    match /hr_attendance/{userId}/{allPaths=**} {
      allow write: if isApproved() && isOwner(userId);
    }
    
    match /gamas-photos/{userId}/{allPaths=**} {
       allow write: if isApproved() && isOwner(userId);
    }

    match /alker-photos/{userId}/{allPaths=**} {
       allow write: if isApproved() && isOwner(userId);
    }
  }
}
