rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /notas/{userId}/{allPaths=**} {
      // Allow public read access to anyone.
      allow read: if true;
      
      // Allow write access to any authenticated user.
      // This is a temporary, permissive rule for debugging the 'storage/unauthorized' error.
      allow write: if request.auth != null;
    }
  }
}
