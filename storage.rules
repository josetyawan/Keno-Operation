rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access for all files so images can be displayed.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Secure write access. Only the authenticated owner of the folder can write.
    match /notas/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
