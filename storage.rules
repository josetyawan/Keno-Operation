rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Files are uploaded to paths like: /notas/{userId}/{fileName}
    
    // Anyone can read any file if they have the URL. This is necessary
    // for the images to be displayed in the app.
    match /{allPaths=**} {
        allow read: if true;
    }

    // A user can only write (create, update, delete) files inside their own
    // user-specific folder within the 'notas' directory.
    match /notas/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
