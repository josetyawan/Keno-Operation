rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY DEBUGGING RULE: Allow all reads and writes to all documents.
    // This is to diagnose client-side issues.
    // WARNING: This is insecure and should be removed after debugging.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
